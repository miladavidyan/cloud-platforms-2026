<mxCell id="run_ic" value='&lt;b&gt;1 vCPU · 2 ГиБ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6368"&gt;min 0 / max 3 экз., таймаут 300 с&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#FFFFFF;image=data:image/svg+xml,;;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=middle;spacingLeft=40;spacingRight=4;align=left;verticalAlign=middle;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="run"><mxGeometry x="15" y="32" width="420" height="46" as="geometry"/></mxCell>
