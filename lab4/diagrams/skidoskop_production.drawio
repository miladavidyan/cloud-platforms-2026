<mxCell id="jobs" value='&lt;b&gt;Cloud Run Jobs: sync-integrations&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6368"&gt;выгрузка из POS → снимок в Cloud Storage → задача в очередь&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#DADCE0;image=data:image/svg+xml,;;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=48;spacingRight=4;align=left;verticalAlign=middle;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="cmp"><mxGeometry x="20" y="523" width="480" height="66" as="geometry"/></mxCell>
<mxCell id="data" value="Данные" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#BDC1C6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="gcp"><mxGeometry x="965" y="50" width="320" height="365" as="geometry"/></mxCell>
<mxCell id="gcs" value='&lt;b&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6368"&gt;tenants/{id}/…, lifecycle 90 дн. / 12 мес.&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#DADCE0;image=data:image/svg+xml,;;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=48;spacingRight=4;align=left;verticalAlign=middle;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="data"><mxGeometry x="15" y="40" width="290" height="80" as="geometry"/></mxCell>
<mxCell id="sql" value='&lt;b&gt;Cloud SQL PostgreSQL · HA&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6368"&gt;db-custom-2-8192 · основной (зона a) + резерв (зона b) · авто-failover&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#DADCE0;image=data:image/svg+xml,;;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=48;spacingRight=4;align=left;verticalAlign=middle;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="data"><mxGeometry x="15" y="135" width="290" height="96" as="geometry"/></mxCell>
<mxCell id="bkp" value='&lt;b&gt;Резервные копии + PITR&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6368"&gt;30 ежедн. копий (мультирегион US), PITR 7 дн.: RPO ≤ 5 мин, RTO ≤ 1 ч&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#DADCE0;image=data:image/svg+xml,;;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=4;align=left;verticalAlign=middle;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="data"><mxGeometry x="15" y="247" width="290" height="80" as="geometry"/></mxCell>
<mxCell id="gcsnote" value="Cloud Storage: soft delete 7 дн. — защита от случайного удаления" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#5F6368;fontFamily=Helvetica;" vertex="1" parent="data"><mxGeometry x="15" y="331" width="290" height="28" as="geometry"/></mxCell>
<mxCell id="b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C5221F;fontSize=11;fontColor=#202124;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;fontFamily=Helvetica;strokeWidth=1.5;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sql" target="bkp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ai" value="AI" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#BDC1C6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="gcp"><mxGeometry x="965" y="435" width="320" height="225" as="geometry"/></mxCell>
<mxCell id="gem" value='&lt;b&gt;Vertex AI · Gemini 3.1 Flash-Lite&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6368"&gt;глобальный эндпоинт, Standard PayGo&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#DADCE0;image=data:image/svg+xml,;;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=48;spacingRight=4;align=left;verticalAlign=middle;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="ai"><mxGeometry x="15" y="40" width="290" height="72" as="geometry"/></mxCell>
<mxCell id="ainote" value="• max_output_tokens и JSON-схема ответа&lt;br&gt;• квота запросов в минуту на проект&lt;br&gt;• в промпт идут агрегаты, а не сырые строки&lt;br&gt;• финансовые числа LLM не вычисляет" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="ai"><mxGeometry x="15" y="120" width="290" height="96" as="geometry"/></mxCell>
<mxCell id="steps" value="&lt;b&gt;Поток обработки&lt;/b&gt;&lt;br&gt;1 · HTTPS через Load Balancer и Cloud Armor&lt;br&gt;2 · api: проверка токена и квоты&lt;br&gt;3 · файл → Cloud Storage по подписанному URL&lt;br&gt;4 · запись анализа, status = queued&lt;br&gt;5 · задача → Cloud Tasks&lt;br&gt;6 · доставка воркеру, повторы&lt;br&gt;7 · чтение файла&lt;br&gt;8 · агрегаты → Gemini, проверка ограничений&lt;br&gt;9 · результат → Cloud SQL&lt;br&gt;10 · ответ пользователю (опрос статуса)&lt;br&gt;11 · Scheduler запускает синхронизацию&lt;br&gt;12 · Job забирает данные из POS по API" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;fontSize=11;fontColor=#202124;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Helvetica;" vertex="1" parent="gcp"><mxGeometry x="1305" y="50" width="290" height="222" as="geometry"/></mxCell>
<mxCell id="guard" value="&lt;b&gt;Защита от роста затрат AI&lt;/b&gt;&lt;br&gt;• квота анализов на компанию&lt;br&gt;• ≤ 20 параллельных вызовов (очередь), max 20 воркеров&lt;br&gt;• бюджет → Pub/Sub → флаг ai_degraded: при 100 % остаются расчёты и шаблонные тексты" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=11;fontColor=#202124;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Helvetica;" vertex="1" parent="gcp"><mxGeometry x="1305" y="287" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="scale" value="&lt;b&gt;Масштабирование&lt;/b&gt;&lt;br&gt;• api: 2 → 30 экземпляров по нагрузке&lt;br&gt;• worker: 0 → 20, темп задаёт Cloud Tasks&lt;br&gt;• пик ≈10 параллельных анализов, запас ×2&lt;br&gt;• Cloud SQL: вертикально (2 → 4 vCPU), затем реплика чтения&lt;br&gt;• Cloud Storage и Gemini масштабируются автоматически" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#8AB4F8;fontSize=11;fontColor=#202124;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontFamily=Helvetica;" vertex="1" parent="gcp"><mxGeometry x="1305" y="452" width="290" height="208" as="geometry"/></mxCell>
