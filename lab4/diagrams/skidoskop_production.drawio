<mxCell id="cmp" value="Вычисления · Cloud Run (автомасштабирование, мультизонально)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#4285F4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="gcp"><mxGeometry x="335" y="50" width="520" height="610" as="geometry"/></mxCell>
<mxCell id="api" value='&lt;b&gt;Cloud Run: api&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6368"&gt;1 vCPU / 1 ГиБ · min 2 / max 30 · concurrency 80 · квоты анализов по тарифу&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#DADCE0;image=data:image/svg+xml,;;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=48;spacingRight=4;align=left;verticalAlign=middle;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="cmp"><mxGeometry x="20" y="45" width="480" height="72" as="geometry"/></mxCell>
<mxCell id="tasks" value='&lt;b&gt;Cloud Tasks: очередь analyses&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6368"&gt;≤ 20 одновременно · 10 доставок/с · 5 повторов → status = failed&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#DADCE0;image=data:image/svg+xml,;;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=48;spacingRight=4;align=left;verticalAlign=middle;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="cmp"><mxGeometry x="20" y="160" width="480" height="66" as="geometry"/></mxCell>
<mxCell id="wk" value="Cloud Run: worker · min 0 / max 20 · concurrency 1 · 1 vCPU / 2 ГиБ" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#F8FBFF;strokeColor=#8AB4F8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="cmp"><mxGeometry x="28" y="265" width="480" height="225" as="geometry"/></mxCell>
