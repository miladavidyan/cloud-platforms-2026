<mxCell id="title" value="Скидоскоп · Этап 2 — тестирование партнёрами (Partner Pilot)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#202124;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1300" height="32" as="geometry"/></mxCell>
<mxCell id="subtitle" value="100 компаний · 250 пользователей · 2 000 анализов в месяц · асинхронная обработка через очередь · расходы ≈7 636 руб./мес." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5F6368;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1500" height="24" as="geometry"/></mxCell>
