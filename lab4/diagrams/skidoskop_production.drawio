<mxCell id="armor" value='&lt;b&gt;Cloud Armor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6368"&gt;WAF (OWASP), rate limit, блок-листы&lt;/font&gt;' style="shape=label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#DADCE0;image=data:image/svg+xml,;;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=4;align=left;verticalAlign=middle;fontSize=13;fontColor=#202124;fontFamily=Helvetica;" vertex="1" parent="edge"><mxGeometry x="15" y="140" width="250" height="70" as="geometry"/></mxCell>
